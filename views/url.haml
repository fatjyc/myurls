%main.shortener-shell
  %section.shortener-hero
    .shortener-copy
      %h1
        Short links.
        %br/
        Less noise.
      %p
        A smaller address for whatever comes next. Paste a URL and share it with
        %strong 1gb.xyz.

    .shortener-stage
      #bar.shortener-flipper
        #front.side.shortener-panel
          %form{:action => "/url", :method => "post"}
            .shortener-field-heading
              %label{:for => "url"} Paste a long URL
              %span.shortener-domain= @url
            .shortener-input-row
              .has-tooltip.shortener-input-wrap
                %input#url{name: "url", placeholder: "https://example.com/something-worth-sharing", type: "url", autocomplete: "url", required: true, "aria-describedby" => "input-tooltip"}/
              %button#start{:type => "submit"}
                %span Shorten link
                %span{"aria-hidden" => "true"} ↗
            %span#input-tooltip.tooltip{:role => "alert"} Could not shorten this URL. Check the address and try again.
          %p.shortener-hint No account needed. Just paste, shorten, and share.

        #back.side.shortener-panel.shortener-result
          %div
            %label.shortener-result-label{:for => "s-url"} Your link, ready to share.
            %input#s-url{name: "url", type: "text", :readonly => "readonly"}/
          .shortener-result-actions
            .has-tooltip
              %span#copy-tooltip.tooltip{:role => "status"} Copied
              %button#copy{"data-clipboard-target" => "#s-url", :type => "button"} Copy link
            %button#restart{:type => "button"} Shorten another ↗

  %section.shortener-manifesto
    %div
      %h2 Less to type. More to share.
      %p Short links for messages, printed pages, and everything in between.
    %a.related-tool{href: "https://xip.1gb.xyz"}
      %span IP address → hostname
      %strong
        Explore xip.1gb.xyz
        %span{"aria-hidden" => "true"} ↗
