%nav.site-nav{:"aria-label" => "Main navigation"}
  .site-nav-inner
    %a.site-logo{href: "/"}= @site_name || 'MYURLS'
    .site-nav-meta
      - if @body_class == 'xip-page'
        %a{href: "https://1gb.xyz"} Short links ↗
        %a{href: "/", "aria-current" => "page"} IP hostnames
      - else
        %a{href: "/", "aria-current" => (@body_class == 'myurls-page' ? 'page' : nil)} Short links
        %a{href: "https://xip.1gb.xyz"} IP hostnames ↗
